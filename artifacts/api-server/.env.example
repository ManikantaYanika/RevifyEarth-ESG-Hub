# Copy to `.env` in this directory. `.env` is gitignored and must never be committed.
#
# The server boots without OPENAI_API_KEY — the assistant endpoint then reports
# itself unavailable (503) and the website's chat launcher hides itself. Everything
# else on the site continues to work.

# ---------------------------------------------------------------------------
# Required for the assistant
# ---------------------------------------------------------------------------

# Secret. Server-side only; never referenced from frontend code, never logged,
# never sent to the browser.
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Optional — shown with their defaults
# ---------------------------------------------------------------------------

# The assistant talks Chat Completions (`POST /v1/chat/completions`), so it runs
# against OpenAI or any OpenAI-compatible gateway with no code change — only these
# two variables. The Responses API is deliberately not used: it is OpenAI-only and
# gateways return 404 for it.
#
#   OpenAI      OPENAI_BASE_URL unset                                        gpt-5.4-mini
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai       gemini-3.5-flash
#   Tokligence  https://llm-api.tokligence.ai/v1                              glm-5
#   OpenRouter  https://openrouter.ai/api/v1                                  openai/gpt-4o-mini
#
# There is no portable default model — a model id only means something to the
# gateway BASE_URL points at. Call `GET <base>/v1/models` to see what is served,
# and check regional availability: on Tokligence the Anthropic models exclude IN.
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# Thinking budget on reasoning models (Gemini 3.x, GPT-5, o-series). Sent only when
# set. REQUIRED for Gemini 3.x: thinking tokens are drawn from the same budget as the
# answer, so at the default effort the model spends it reasoning and the reply is cut
# off mid-sentence after one chunk. "low" still reasons and leaves room to answer.
# OPENAI_REASONING_EFFORT=low

# OPENAI_MAX_OUTPUT_TOKENS=900
# OPENAI_TIMEOUT_MS=45000
# Retries after the first attempt, with exponential backoff + jitter, honouring the
# provider's own retry hint. Only failures that can clear are retried: transient 5xx,
# network, timeout, and per-MINUTE rate limits. A per-DAY quota, an auth fault or a
# bad model are not retried — the attempt would fail identically.
# OPENAI_MAX_RETRIES=3

# Models to fall back to, in order, when the primary is quota-exhausted or unserved.
# Gemini's free tier meters 20 requests/day PER MODEL, so one model cannot keep a
# public page answering. Comma separated.
# OPENAI_MODEL_FALLBACKS=gemini-3.5-flash-lite,gemini-3.6-flash

# Browser origins allowed to call the API cross-origin, comma separated.
# Leave empty for same-origin only — correct when the SPA is served from this host,
# and correct in development because Vite proxies /api.
# ASSISTANT_ALLOWED_ORIGINS=https://www.revifyearth.com

# Per-IP sliding window.
# ASSISTANT_RATE_LIMIT_WINDOW_MS=60000
# ASSISTANT_RATE_LIMIT_MAX=12

# Process-wide daily ceiling, protecting the API budget against distributed abuse.
# ASSISTANT_DAILY_MAX_REQUESTS=2000

# PORT=5000
# LOG_LEVEL=info
